^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE270357
!Series_title = Transcriptome sequencing of palmitic acid-treated HepG2 cells upon intervention of curcumin or curcumin-copper complex
!Series_geo_accession = GSE270357
!Series_status = Public on Jun 19 2026
!Series_submission_date = Jun 20 2024
!Series_last_update_date = Jun 19 2026
!Series_summary = Globally, non-alcoholic fatty liver disease (NAFLD) poses a major risk to human health. The natural polyphenol curcumin (Cur) can act as a copper (Cu) transporter in a Cur-Cu complex for enhanced Cu cell loading, but the effects of such a complex on NAFLD remain unclear. HepG2 liver cancer cells were treated with palmitic acid (PA) to create an in-vitro NAFLD model. And the purpose of this study was to investigate the impacts of a Cur- Cu complex on this model, and its potential mechanisms and targets in the reduction of fatty-acid accumulation in HepG2 cells.
!Series_overall_design = We performed RNA expression profiling analysis using data obtained from RNA sequencing (RNA-seq) of PA-treated HepG2 cells with Cur alone or co-treated with Cur and CuCl2 for 12 h. For PA group, The HepG2 cells pre-treated with 750 μM for 24h. For PA-Cur group, the cells pre-treated with 750 μM for 24h, were then incubated with 20 μM Cur for 12 h. For PA-Cur-Cu group, the PA-treated HepG2 cells were co-treated with Cur (20 µM) and CuCl2 (5 µM) for 12 h. RNA-seq was performed on three replicates per condition.PA: PA-stimulated HepG2 cells, PA-Cur: Cur treated PA-stimulated HepG2 cells.PA–Cur-Cu: Cur-Cu treated PA-stimulated HepG2 cells
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Si,,Qin
!Series_contributor = Xiang,,Li
